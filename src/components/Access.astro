---
import { hotel, mapUrl, directionsUrl, mapEmbedUrl } from '../data/hotel';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---
<section class="access section" id="access" aria-labelledby="access-title"><div class="wrap">
  <div class="access__heading"><SectionHeading number="04" english="Access" japanese="アクセス" id="access-title" /><p class="access__station" data-reveal>{hotel.station}から<span>徒歩 <b>{hotel.walkMinutes}</b> 分</span></p></div>
  <div class="access__layout"><div class="access__map" data-reveal><iframe title="HOTEL BUSTELの所在地を示すGoogleマップ" src={mapEmbedUrl} width="900" height="600" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div><div class="access__address" data-reveal><span class="eyebrow">FIND US IN ISEZAKICHO</span><p class="access__name">{hotel.name}</p><address>{hotel.addressLines.map(line => <span class="address-line">{line}</span>)}</address><a class="text-link" href={mapUrl} target="_blank" rel="noopener noreferrer">Googleマップで見る<Icon name="pin" /></a><a class="text-link" href={directionsUrl} target="_blank" rel="noopener noreferrer">徒歩での経路を調べる<Icon name="external" /></a></div></div>
</div></section>
