---
interface Props {
  name?: 'arrow' | 'external' | 'phone' | 'pin' | 'plus' | 'close' | 'chevron';
  class?: string;
}
const { name = 'arrow', class: className } = Astro.props;
const paths = {
  arrow: 'M3 12h17M14 5l7 7-7 7',
  external: 'M14 4h6v6M20 4l-9 9M10 4H4v16h16v-6',
  phone: 'M8 3H4c-.6 0-1 .5-1 1 0 9.4 7.6 17 17 17 .5 0 1-.4 1-1v-4l-5-2-2 2a15 15 0 0 1-6-6l2-2-2-5Z',
  pin: 'M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  plus: 'M12 4v16M4 12h16',
  close: 'm5 5 14 14M19 5 5 19',
  chevron: 'm9 5 7 7-7 7',
};
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
